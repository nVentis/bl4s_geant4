<lccdd>

  <includes>
    <gdmlFile ref="elements.xml"/>
    <gdmlFile ref="materials.xml"/>
  </includes>
  
  <define>
    <include ref="GlassBarConstants.xml"/>
  </define>

  <limits>
    <include ref="GlassBar_Limits.xml"/>
  </limits>

