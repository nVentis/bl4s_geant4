<?xml version="1.0" encoding="UTF-8"?>
<!-- taken and modified from https://github.com/AIDASoft/DD4hep/blob/master/DDDetectors/compact/materials.xml -->
<lccdd>

  <!-- Flat RINDEX tables over a shared visible/near-UV range
       (1.75*eV ~ 708nm to 4.13*eV ~ 300nm), covering typical SiPM
       sensitivity and most of the natural Cherenkov spectrum. -->
  <properties>
    <matrix name="Air__RINDEX" coldim="2" values="
      1.75*eV 1.0
      4.13*eV 1.0
    "/>
    <matrix name="LeadGlass__RINDEX" coldim="2" values="
      1.75*eV 1.47
      4.13*eV 1.47
    "/>
    <!-- Placeholder bulk attenuation length; replace with a real
         manufacturer value if available. Without this, photons trapped
         by total internal reflection at the bar's untreated side walls
         (critical angle ~43deg for 1.47 -> 1.0) never get killed and can
         bounce indefinitely, blowing up run time/memory. Geant4 applies
         survival as exp(-pathLength/ABSLENGTH) continuously along the
         track, so this bounds photon lifetime regardless of bounce count. -->
    <matrix name="LeadGlass__ABSLENGTH" coldim="2" values="
      1.75*eV 1000.0*cm
      4.13*eV 1000.0*cm
    "/>
    <matrix name="Silicon__RINDEX" coldim="2" values="
      1.75*eV 1.0
      4.13*eV 1.0
    "/>
    <matrix name="Silicon__ABSLENGTH" coldim="2" values="
      1.75*eV 0.001*cm
      4.13*eV 0.001*cm
    "/>
  </properties>

  <materials>

    <!--
         Air by weight from

         http://www.engineeringtoolbox.com/air-composition-24_212.html
    -->
    <material name="Air">
      <D type="density" unit="g/cm3" value="0.0012"/>
      <fraction n="0.754" ref="N"/>
      <fraction n="0.234" ref="O"/>
      <fraction n="0.012" ref="Ar"/>
      <property name="RINDEX" ref="Air__RINDEX"/>
    </material>

    <!-- taken from https://geant4.web.cern.ch/documentation/dev/bfad_html/ForApplicationDevelopers/Appendix/materialNames.html -->
    <material name="LeadGlass">
      <D type="density" unit="g/cm3" value="2.4" />
      <fraction n="0.4598" ref="O" />
      <fraction n="0.0964411" ref="Na" />
      <fraction n="0.336553" ref="Si" />
      <fraction n="0.107205" ref="Ca" />
      <property name="RINDEX" ref="LeadGlass__RINDEX"/>
      <property name="ABSLENGTH" ref="LeadGlass__ABSLENGTH"/>

      <!--
       4             G4_GLASS_PLATE        2.4     145.4
           8        0.4598
          11     0.0964411
          14      0.336553
          20      0.107205
      -->
    </material>

    <!-- We model vakuum just as very thin air -->
    <material name="Vacuum">
      <D type="density" unit="g/cm3" value="0.0000000001" />
      <fraction n="0.754" ref="N"/>
      <fraction n="0.234" ref="O"/>
      <fraction n="0.012" ref="Ar"/>
    </material>

    <material name="Epoxy">
      <D type="density" value="1.3" unit="g/cm3"/>
      <composite n="44" ref="H"/>
      <composite n="15" ref="C"/>
      <composite n="7"  ref="O"/>
    </material>

    <material name="Quartz">
      <D type="density" value="2.2" unit="g/cm3"/>
      <composite n="1" ref="Si"/>
      <composite n="2" ref="O"/>
    </material>

    <!-- SiPM bulk material. Named SiPM_Silicon, NOT Silicon: elements.xml
         already defines a plain "Silicon" material (line ~708), and since
         it loads before materials.xml, Converter<Material> would see the
         name already taken and silently skip our whole block (density,
         composite, AND the RINDEX/ABSLENGTH properties below); this bit
         us once already.
         Needs a real RINDEX: without one, Geant4's boundary process kills
         the photon while it's still leaving LeadGlassBar (attributing the
         hit to LeadGlassBar's SD, not SiPM's) rather than letting it cross
         into this volume at all. n=1.0 avoids adding extra Fresnel
         reflection loss at the interface beyond what's already modeled;
         ABSLENGTH is short so the photon is promptly absorbed once inside,
         generating a hit here (idealized; real Si has n~3.5-6 with
         wavelength-dependent absorption; revisit if you need real
         PDE/Fresnel fidelity at the window). -->
    <material name="SiPM_Silicon">
      <D type="density" unit="g/cm3" value="2.33"/>
      <composite n="1" ref="Si"/>
      <property name="RINDEX" ref="Silicon__RINDEX"/>
      <property name="ABSLENGTH" ref="Silicon__ABSLENGTH"/>
    </material>

    <material name="G10">
      <D type="density" value="1.7" unit="g/cm3"/>
      <fraction n="0.08"  ref="Cl"/>
      <fraction n="0.773" ref="Quartz"/>
      <fraction n="0.147" ref="Epoxy"/>
    </material>

    <material name="Polystyrene">
      <D value="1.032" unit="g/cm3"/>
      <composite n="19" ref="C"/>
      <composite n="21" ref="H"/>
    </material>

    <material name="Steel235">
      <D value="7.85" unit="g/cm3"/>
      <fraction n="0.998" ref="Fe"/>
      <fraction n=".002"  ref="C"/>
    </material>

    <material name="SiliconOxide">
      <D type="density" value="2.65" unit="g/cm3"/>
      <composite n="1" ref="Si"/>
      <composite n="2" ref="O"/>
    </material>

    <material name="BoronOxide">
      <D type="density" value="2.46" unit="g/cm3"/>
      <composite n="2" ref="B"/>
      <composite n="3" ref="O"/>
    </material>

    <material name="SodiumOxide">
      <D type="density" value="2.65" unit="g/cm3"/>
      <composite n="2" ref="Na"/>
      <composite n="1" ref="O"/>
    </material>

    <material name="AluminumOxide">
      <D type="density" value="3.89" unit="g/cm3"/>
      <composite n="2" ref="Al"/>
      <composite n="3" ref="O"/>
    </material>

    <material name="PyrexGlass">
      <D type="density" value="2.23" unit="g/cm3"/>
      <fraction n="0.806" ref="SiliconOxide"/>
      <fraction n="0.130" ref="BoronOxide"/>
      <fraction n="0.040" ref="SodiumOxide"/>
      <fraction n="0.023" ref="AluminumOxide"/>
    </material>

    <material name="CarbonFiber">
      <D type="density" value="1.5" unit="g/cm3"/>
      <fraction n="0.65" ref="C"/>
      <fraction n="0.35" ref="Epoxy"/>
    </material>

    <material name="CarbonFiber_50D">
      <D type="density" value="0.75" unit="g/cm3"/>
      <fraction n="0.65" ref="C"/>
      <fraction n="0.35" ref="Epoxy"/>
    </material>

    <material name="PolystyreneFoam">
      <D type="density" value="0.0056" unit="g/cm3"/>
      <fraction n="1.0" ref="Polystyrene"/>
    </material>

    <material name="Kapton">
      <D value="1.43" unit="g/cm3" />
      <composite n="22" ref="C"/>
      <composite n="10" ref="H" />
      <composite n="2" ref="N" />
      <composite n="5" ref="O" />
    </material>

  </materials>

</lccdd>
